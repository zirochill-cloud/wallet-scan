# Copy to `.env` (gitignored) and fill in your key from https://dashboard.helius.dev
# The collector reads HELIUS_API_KEY from the environment — load it before running:
#   set -a; source .env; set +a
HELIUS_API_KEY=

# Postgres DSN for the ledger/database (optional; can also be passed with --dsn)
# SOLSCOPE_PGDSN=postgresql://localhost/solscope